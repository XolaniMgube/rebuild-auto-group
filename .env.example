# Copy to .env.local.
# Hosted: Supabase dashboard → Project Settings → API Keys.
# Local:  run `npm run db:start` and use the URL and publishable key it prints.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# The app never needs a secret or service-role key in the browser.
# Never prefix one with NEXT_PUBLIC_.
