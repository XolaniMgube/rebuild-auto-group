// =====================================================
// Rebuild Auto Group — salvage inventory & sales
// Postgres (Supabase) + Prisma
//
// Nothing is connected yet. The demo runs on in-browser
// state. This file is the target shape for when it is.
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------
// USERS — Mitchel & partner. Role kept for future staff.
// -----------------------------------------------------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  vehiclesAdded Vehicle[]
  partsAdded    Part[]
  sales         Sale[]
}

enum Role {
  OWNER // full access, including money
  STAFF // future: counter use, no financials
}

// -----------------------------------------------------
// VEHICLE — the donor car everything is stripped from.
// The spine of the system: profit-per-car and "what fits
// a 2012 Polo" both hang off this.
// -----------------------------------------------------
model Vehicle {
  id           String  @id @default(cuid())
  make         String
  model        String
  year         Int? // not always known on a wreck
  vin          String?
  registration String?
  color        String?

  purchasePrice Decimal  @db.Decimal(10, 2)
  purchaseDate  DateTime @default(now())
  notes         String?

  parts     Part[]
  addedBy   User     @relation(fields: [addedById], references: [id])
  addedById String
  createdAt DateTime @default(now())

  @@index([make, model, year])
}

// -----------------------------------------------------
// PART — an individual item pulled off a vehicle.
// -----------------------------------------------------
model Part {
  id           String    @id @default(cuid())
  name         String
  brand        String?
  serialNumber String?
  condition    Condition @default(GOOD)
  description  String?

  costPrice    Decimal? @db.Decimal(10, 2)
  sellingPrice Decimal  @db.Decimal(10, 2) @default(0)

  quantity Int     @default(1)
  location String? // yard bin: "Rack B3", "Container 2"

  status PartStatus @default(IN_STOCK)

  images PartImage[]

  // Nullable: parts occasionally come in loose, not off a car.
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  addedBy   User   @relation(fields: [addedById], references: [id])
  addedById String

  saleItems SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@index([vehicleId])
}

enum Condition {
  GOOD
  FAIR
  SPARES_ONLY
}

enum PartStatus {
  DRAFT     // shot on the phone, details still missing
  IN_STOCK
  RESERVED  // customer called, holding it
  SOLD
  RETURNED
}

// -----------------------------------------------------
// PART IMAGE — URLs only. Files live in Supabase Storage.
// -----------------------------------------------------
model PartImage {
  id        String   @id @default(cuid())
  url       String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  partId    String
  createdAt DateTime @default(now())

  @@index([partId])
}

// -----------------------------------------------------
// SALE — one transaction, one or more parts.
// -----------------------------------------------------
model Sale {
  id       String   @id @default(cuid())
  saleDate DateTime @default(now())

  customerName  String?
  customerPhone String?

  total Decimal @db.Decimal(10, 2)

  items SaleItem[]

  soldBy   User   @relation(fields: [soldById], references: [id])
  soldById String

  notes     String?
  createdAt DateTime @default(now())

  @@index([saleDate])
}

// -----------------------------------------------------
// SALE ITEM — price is FROZEN here on purpose.
// If it pointed at Part.sellingPrice, re-pricing a part
// next month would silently rewrite last month's revenue.
// -----------------------------------------------------
model SaleItem {
  id     String @id @default(cuid())
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId String
  part   Part   @relation(fields: [partId], references: [id])
  partId String

  quantity    Int      @default(1)
  priceAtSale Decimal  @db.Decimal(10, 2)
  costAtSale  Decimal? @db.Decimal(10, 2)

  @@index([saleId])
  @@index([partId])
}
